== setup
log C [somfy.iohc.hub] Setting up Somfy iohc hub...
cc1101.set_frequency(868924992)
cc1101.set_modulation_type(0)
cc1101.set_symbol_rate(38400)
cc1101.set_fsk_deviation(19200)
cc1101.set_filter_bandwidth(100000)
cc1101.set_manchester(0)
cc1101.set_sync1(87)
cc1101.set_sync0(253)
cc1101.set_magn_target(3)
cc1101.set_max_lna_gain(0)
cc1101.set_max_dvga_gain(0)
cc1101.set_lna_priority(1)
cc1101.set_carrier_sense_abs_thr(-8)
cc1101.set_carrier_sense_rel_thr(1)
cc1101.set_sync_mode(2)
cc1101.set_carrier_sense_above_threshold(1)
cc1101.set_crc_enable(0)
cc1101.set_packet_length(60)
cc1101.register_listener()
cc1101.begin_rx()
